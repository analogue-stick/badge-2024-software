{
    "configurations": [
        {
            "type": "gdb",
            "request": "attach",
            "name": "Attach to gdbserver",
            "executable": "./micropython/ports/esp32/build-tildagon/micropython.elf",
            "target": ":3333",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText",
            "gdbpath": "/home/molive/.espressif/tools/xtensa-esp-elf-gdb/14.2_20240403/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb",
            "autorun": [
                "set remote hardware-watchpoint-limit 2",
                "set substitute-path /firmware ${workspaceRoot}",
                "set substitute-path /opt/esp/idf /opt/esp-idf",
                "monitor reset halt",
                "maintenance flush register-cache",
                "thbreak app_main",
            ]
        }
    ]
}